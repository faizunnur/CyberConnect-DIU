# Copy to .env (never committed) and replace every CHANGE_ME.
# Generate strong values automatically:  pwsh/powershell scripts/gen-secrets.ps1   or   sh scripts/gen-secrets.sh
# The same file feeds Docker Compose and the natively-run backend (spring.config.import).

# --- Ports published on 127.0.0.1 for native development (5433 avoids clashing with a local PostgreSQL service) ---
APP_PORT=8088
DB_PORT=5433
REDIS_PORT=6379
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
SMTP_PORT=1025

# --- PostgreSQL (two roles: migrator owns the schema, app has least privilege) ---
DB_NAME=cyberconnect
DB_MIGRATOR_USER=cyberconnect_migrator
DB_MIGRATOR_PASSWORD=CHANGE_ME
DB_APP_USER=cyberconnect_app
DB_APP_PASSWORD=CHANGE_ME

# --- Redis (sessions, rate limits) ---
REDIS_PASSWORD=CHANGE_ME

# --- Object storage (S3 API; RustFS locally) ---
STORAGE_ACCESS_KEY=cyberconnect
STORAGE_SECRET_KEY=CHANGE_ME

# --- Identity-document encryption (base64 of exactly 32 random bytes) ---
DOCUMENT_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
DOCUMENT_ENCRYPTION_KEY_ID=k1

# --- Malware scanning: noop (dev only) or clamav (requires `--profile scanning`) ---
SCANNER_TYPE=noop

# --- Email (Mailpit locally; real SMTP in production: SMTP_HOST/PORT/USERNAME/PASSWORD/AUTH, SMTP_SSL=true for 465
#     or SMTP_STARTTLS=true for 587) ---
MAIL_FROM=no-reply@cyberconnect.local

# --- First administrator: the account that registers with this email becomes SUPER_ADMIN (clear after use) ---
BOOTSTRAP_SUPER_ADMIN_EMAIL=
# Dev only: lets Playwright create verified test members via POST /api/v1/dev/fixtures/verified-member.
E2E_FIXTURES_ENABLED=true
